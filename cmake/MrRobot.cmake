include_guard(GLOBAL)

# Project-owned target supplies BSP implementations, HAL/RTOS include paths and
# compiler definitions. This registers capabilities; it never initializes HAL.
function(mr_register_board_adapter)
    cmake_parse_arguments(MR "" "TARGET;PROFILE" "CAN_ENDPOINTS;UART_ENDPOINTS" ${ARGN})
    if(MR_UNPARSED_ARGUMENTS OR MR_KEYWORDS_MISSING_VALUES OR NOT MR_TARGET OR NOT MR_PROFILE)
        message(FATAL_ERROR "mr_register_board_adapter requires TARGET and PROFILE")
    endif()
    if(NOT TARGET "${MR_TARGET}")
        message(FATAL_ERROR "Board adapter TARGET '${MR_TARGET}' does not exist")
    endif()
    set_property(TARGET ${MR_TARGET} PROPERTY MR_ROBOT_BOARD_PROFILE "${MR_PROFILE}")
    set_property(TARGET ${MR_TARGET} PROPERTY MR_ROBOT_CAN_ENDPOINTS "${MR_CAN_ENDPOINTS}")
    set_property(TARGET ${MR_TARGET} PROPERTY MR_ROBOT_UART_ENDPOINTS "${MR_UART_ENDPOINTS}")
endfunction()

# Add generated assembly usage to an EXISTING firmware target. Main/startup,
# linker and CubeMX peripheral initialization remain project-owned.
function(mr_target_robot_config)
    cmake_parse_arguments(MR "" "TARGET;CONFIG;MODULE;TASK;BOARD_TARGET;PYTHON;OUTPUT_DIRECTORY" "" ${ARGN})
    # PYTHON may be an empty optional cache entry.
    list(REMOVE_ITEM MR_KEYWORDS_MISSING_VALUES PYTHON)
    if(MR_UNPARSED_ARGUMENTS OR MR_KEYWORDS_MISSING_VALUES OR NOT MR_TARGET
            OR NOT MR_CONFIG OR NOT MR_MODULE OR NOT MR_BOARD_TARGET)
        message(FATAL_ERROR "mr_target_robot_config requires existing TARGET, CONFIG, MODULE and BOARD_TARGET")
    endif()
    if(NOT TARGET "${MR_TARGET}" OR NOT TARGET "${MR_BOARD_TARGET}")
        message(FATAL_ERROR "TARGET '${MR_TARGET}' and BOARD_TARGET '${MR_BOARD_TARGET}' must exist")
    endif()
    get_filename_component(_mr_library "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    get_filename_component(_mr_config "${MR_CONFIG}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT MR_OUTPUT_DIRECTORY)
        set(MR_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
    endif()
    get_filename_component(MR_OUTPUT_DIRECTORY "${MR_OUTPUT_DIRECTORY}" ABSOLUTE
        BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    if(NOT MR_PYTHON)
        find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
        set(MR_PYTHON "${Python3_EXECUTABLE}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_mr_config}" "${_mr_library}/docs/robot.schema.json"
        "${_mr_library}/tools/mrctl.py" "${_mr_library}/tools/robot_config.py"
        "${_mr_library}/tools/task_generator.py"
        "${_mr_library}/tools/validate_robot_config.py" "${_mr_library}/cmake/targets.json")
    set(_mr_task_args)
    if(MR_TASK)
        list(APPEND _mr_task_args --task "${MR_TASK}")
    endif()
    execute_process(COMMAND "${MR_PYTHON}" "${_mr_library}/tools/mrctl.py"
        generate "${_mr_config}" --module "${MR_MODULE}" --output-dir "${MR_OUTPUT_DIRECTORY}"
        ${_mr_task_args}
        RESULT_VARIABLE _mr_result OUTPUT_VARIABLE _mr_output ERROR_VARIABLE _mr_error)
    if(NOT _mr_result EQUAL 0)
        message(FATAL_ERROR "Robot configuration generation failed:\n${_mr_output}${_mr_error}")
    endif()
    include("${MR_OUTPUT_DIRECTORY}/robot.cmake")
    get_target_property(_mr_profile ${MR_BOARD_TARGET} MR_ROBOT_BOARD_PROFILE)
    get_target_property(_mr_endpoints ${MR_BOARD_TARGET} MR_ROBOT_CAN_ENDPOINTS)
    get_target_property(_mr_uart_endpoints ${MR_BOARD_TARGET} MR_ROBOT_UART_ENDPOINTS)
    if(NOT _mr_profile STREQUAL MR_GENERATED_BOARD_PROFILE)
        message(FATAL_ERROR "Board adapter profile '${_mr_profile}' does not match config '${MR_GENERATED_BOARD_PROFILE}'")
    endif()
    if(NOT MR_GENERATED_CAN_BINDING IN_LIST _mr_endpoints)
        message(FATAL_ERROR "Board adapter does not provide CAN endpoint '${MR_GENERATED_CAN_BINDING}'")
    endif()
    foreach(_mr_uart IN LISTS MR_GENERATED_UART_ENDPOINTS)
        if(NOT _mr_uart IN_LIST _mr_uart_endpoints)
            message(FATAL_ERROR "Board adapter does not provide UART endpoint '${_mr_uart}'")
        endif()
    endforeach()
    foreach(_mr_target IN LISTS MR_GENERATED_TARGETS)
        if(NOT TARGET ${_mr_target})
            message(FATAL_ERROR "Missing library target '${_mr_target}'; add_subdirectory(MR_TestLib) first")
        endif()
    endforeach()
    target_include_directories(${MR_TARGET} PRIVATE "${MR_GENERATED_INCLUDE_DIR}")
    if(MR_GENERATED_TASK_SOURCES)
        target_sources(${MR_TARGET} PRIVATE ${MR_GENERATED_TASK_SOURCES})
    endif()
    target_compile_definitions(${MR_TARGET} PRIVATE "MR_ROBOT_CAN_BINDING=${MR_GENERATED_CAN_BINDING}")
    target_link_libraries(${MR_TARGET} PRIVATE ${MR_BOARD_TARGET} ${MR_GENERATED_TARGETS})
    message(STATUS "Robot module '${MR_MODULE}': ${MR_GENERATED_TARGETS}; board ${_mr_profile}/${MR_GENERATED_CAN_BINDING}")
endfunction()
