include_guard(GLOBAL)

# Optional adapter for the CURRENT H723 BSP implementation. Cube owns hardware
# configuration/IRQ files; this helper only chooses MR sources and their closure.
function(mr_add_stm32h7_bsp)
    cmake_parse_arguments(MR "" "TARGET;PLATFORM;PROFILE" "COMPONENTS" ${ARGN})
    if(MR_UNPARSED_ARGUMENTS OR MR_KEYWORDS_MISSING_VALUES OR NOT MR_TARGET OR NOT MR_PLATFORM
            OR NOT MR_PROFILE STREQUAL "h723_zzrobot")
        message(FATAL_ERROR "mr_add_stm32h7_bsp requires TARGET, existing PLATFORM and PROFILE h723_zzrobot")
    endif()
    if(NOT TARGET "${MR_PLATFORM}")
        message(FATAL_ERROR "PLATFORM '${MR_PLATFORM}' must exist")
    endif()
    if(NOT MR_COMPONENTS)
        message(FATAL_ERROR "Select COMPONENTS: can, uart, mrlink, pwm, gpio, spi")
    endif()
    set(_mr_parts ${MR_COMPONENTS})
    foreach(_mr_part IN LISTS MR_COMPONENTS)
        if(_mr_part STREQUAL "mrlink")
            # channel.c exposes UART/FDCAN/USB constructors in one public unit.
            list(APPEND _mr_parts can uart mrlink dma)
        elseif(_mr_part STREQUAL "can")
            list(APPEND _mr_parts time mm)
        elseif(_mr_part STREQUAL "uart" OR _mr_part STREQUAL "spi")
            list(APPEND _mr_parts dma)
        elseif(_mr_part STREQUAL "pwm" OR _mr_part STREQUAL "gpio")
            # Plain PWM/GPIO do not depend on DMA, RTOS or the CAN manager.
        else()
            message(FATAL_ERROR "Unknown H723 BSP component '${_mr_part}'")
        endif()
    endforeach()
    if(can IN_LIST _mr_parts)
        list(APPEND _mr_parts time mm)
    endif()
    list(REMOVE_DUPLICATES _mr_parts)
    get_filename_component(_mr_library "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(_mr_sources)
    foreach(_mr_part IN LISTS _mr_parts)
        if(_mr_part STREQUAL "can")
            list(APPEND _mr_sources "${_mr_library}/User/bsp/fdcan.c")
        elseif(_mr_part STREQUAL "mrlink")
            foreach(_mr_backend channel channel_uart channel_fdcan channel_usb)
                list(APPEND _mr_sources "${_mr_library}/User/bsp/mrlink/${_mr_backend}.c")
            endforeach()
        else()
            list(APPEND _mr_sources "${_mr_library}/User/bsp/${_mr_part}.c")
        endif()
    endforeach()
    add_library(${MR_TARGET} OBJECT ${_mr_sources})
    target_include_directories(${MR_TARGET} PUBLIC "${_mr_library}/User")
    target_link_libraries(${MR_TARGET} PUBLIC ${MR_PLATFORM})
    if(mrlink IN_LIST _mr_parts)
        target_link_libraries(${MR_TARGET} PUBLIC mr::component_mrlink)
    endif()
    target_compile_features(${MR_TARGET} PUBLIC c_std_11)
endfunction()
